#!/usr/bin/env python3
"""Sync _data/music.yml with the Obsidian note.

Usage: bin/add-songs [--dry-run] [--refresh] [path/to/note.md]

The note has an abbreviation block ("nfak - Nusrat Fateh Ali Khan") followed by
a "*Song list*" heading and one "title - artist" per line. For each new song this
finds the track on Apple, saves a 300px cover, stores the 30 s preview (public
iTunes API) and the 90 s preview (from the song's music.apple.com page), and
guesses a genre. Check the guesses it prints before committing.

--refresh also rechecks every song already on the page: it looks up the same
Apple track (so hand-picked versions stay), updates its preview links, Apple
Music link and cover if Apple changed them, searches again if the track is gone,
and removes songs that are no longer in the note (after asking). Titles, artists,
genres and notes are never changed.

--dry-run shows what would happen without writing anything.
Needs macOS (sips resizes covers) and Pillow (compares covers).
"""
import difflib, json, os, re, shlex, subprocess, sys, tempfile, time, unicodedata
import urllib.error, urllib.parse, urllib.request
import yaml
from PIL import Image, ImageChops

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
YML = os.path.join(ROOT, "_data", "music.yml")
COVERS = os.path.join(ROOT, "assets", "images", "music")
NOTE = os.path.expanduser("~/Documents/2B/2B/songs to be added on the music page.md")
GENRES = ["sufi", "ghazal", "hindi-film", "rock", "pop-folk", "punjabi", "indie", "soul-reggae-blues"]
# Apple's primaryGenreName -> section on the page, used when the artist is new.
APPLE_GENRES = {
    "Sufi": "sufi", "Devotional & Spiritual": "sufi", "Qawwali": "sufi",
    "Ghazals": "ghazal",
    "Bollywood": "hindi-film", "Indian Classical": "hindi-film",
    "Rock": "rock", "Alternative": "rock", "Hard Rock": "rock", "Metal": "rock",
    "Pop": "pop-folk", "Singer/Songwriter": "pop-folk", "Folk": "pop-folk", "Country": "pop-folk",
    "Punjabi Pop": "punjabi", "Punjabi": "punjabi",
    "Indian Pop": "indie", "Indie Pop": "indie", "Indian": "indie",
    "R&B/Soul": "soul-reggae-blues", "Soul": "soul-reggae-blues", "Reggae": "soul-reggae-blues",
    "Blues": "soul-reggae-blues", "Jazz": "soul-reggae-blues", "Latin": "soul-reggae-blues",
}
FIELDS = ["title", "artist", "genre", "thumbnail", "note", "previewUrl", "extendedPreviewUrl", "appleMusicUrl"]
UA = {"User-Agent": "Mozilla/5.0"}


def norm(s):
    s = unicodedata.normalize("NFKD", s).lower()
    s = re.sub(r"\(.*?\)|\bfrom\b.*$", "", s)
    return re.sub(r"[^a-z0-9]", "", s)


def similar(a, b, cutoff=0.75):
    """Fuzzy match that tolerates spelling (pyaar/pyar) and one side being longer."""
    a, b = norm(a), norm(b)
    if not a or not b:
        return False
    n = min(len(a), len(b))
    return (difflib.SequenceMatcher(None, a, b).ratio() >= cutoff
            or difflib.SequenceMatcher(None, a[:n], b[:n]).ratio() >= 0.85 and n >= 6)


def artist_matches(note_artist, apple_artist):
    return any(similar(note_artist, part) for part in re.split(r",|&|\bfeat\.?", apple_artist))


def read_note(path):
    text = open(path).read()
    head, _, songs = text.partition("*Song list*")
    abbr = {}
    for line in head.splitlines():
        m = re.match(r"\s*(\S+)\s+-\s+(.+)", line)
        if m:
            abbr[m.group(1).lower()] = m.group(2).strip()
    out = []
    for line in songs.splitlines():
        m = re.match(r"\s*(.+?)\s*-\s+(.+?)\s*$", line) or re.match(r"\s*(.+?)\s+-\s*(.+?)\s*$", line)
        if m:
            artist = m.group(2)
            out.append((line.strip(), m.group(1), abbr.get(artist.lower(), artist)))
    return out


def dump(tracks):
    out = []
    for t in tracks:
        for i, k in enumerate(f for f in FIELDS if t.get(f) is not None):
            v = t[k] if k == "genre" else json.dumps(t[k], ensure_ascii=False)
            out.append(f"{'- ' if i == 0 else '  '}{k}: {v}")
    return "\n".join(out) + "\n"


def get(url):
    return urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=20).read()


def find_on_apple(title, artist):
    term = re.sub(r"\bfrom\b.*$", "", title, flags=re.I).strip() + " " + artist
    for country in ("us", "in"):
        q = urllib.parse.urlencode({"term": term, "entity": "song", "limit": 15, "country": country})
        results = json.loads(get(f"https://itunes.apple.com/search?{q}"))["results"]
        time.sleep(3)  # the iTunes API allows about 20 calls a minute
        for r in results:
            if r.get("previewUrl") and artist_matches(artist, r["artistName"]) and similar(title, r["trackName"], 0.6):
                return r
    return None


def lookup(apple_url):
    """The same Apple track again, or None if Apple no longer has it."""
    sf = re.search(r"music\.apple\.com/(\w+)/", apple_url).group(1)
    tid = re.search(r"[?&]i=(\d+)", apple_url).group(1)
    results = json.loads(get(f"https://itunes.apple.com/lookup?id={tid}&country={sf}"))["results"]
    time.sleep(3)
    return next((r for r in results if r.get("previewUrl")), None)


def extended_preview(apple_url):
    sf = re.search(r"music\.apple\.com/(\w+)/", apple_url).group(1)
    tid = re.search(r"[?&]i=(\d+)", apple_url).group(1)
    try:
        html = get(f"https://music.apple.com/{sf}/song/{tid}").decode()
    except urllib.error.HTTPError:
        return None
    eps = set(re.findall(r'https://audio-ssl[^"\\]*\.ep\.m4a', html))
    return eps.pop() if len(eps) == 1 else None


def clean_title(t):
    t = re.sub(r"\s*\((From|feat\.|Remastered|Full Length|Live|Raag)[^)]*\)", "", t)
    return t.title() if t.isupper() else t


def guess_genre(artist, apple_genre, tracks):
    known = [t["genre"] for t in tracks if artist_matches(artist, t["artist"])]
    if known:
        return max(set(known), key=known.count), "same artist"
    if apple_genre in APPLE_GENRES:
        return APPLE_GENRES[apple_genre], f"Apple says {apple_genre}"
    return None, f"Apple says {apple_genre}"


def fetch_cover(r, path):
    urllib.request.urlretrieve(r["artworkUrl100"].replace("100x100bb", "600x600bb"), path)
    subprocess.run(["sips", "-Z", "300", path], capture_output=True, check=True)


def same_image(a, b):
    """True when two covers look alike; re-encoding alone makes the bytes differ."""
    try:
        im = [Image.open(p).convert("L").resize((16, 16)) for p in (a, b)]
    except OSError:
        return False
    return sum(ImageChops.difference(*im).getdata()) / 256 < 12


def refresh(t, line, title, artist, dry, changes, problems):
    """Update the links and cover of a song already on the page, in place."""
    r = lookup(t["appleMusicUrl"])
    if not r:
        r = find_on_apple(title, artist)
        if not r:
            problems.append(f"  GONE from Apple and no replacement found (left as is): {line}")
            return
        changes.append(f"  REPLACED {t['title']}: Apple dropped the track, now {r['trackName']} | {r['artistName']}")
    for field, value in (("previewUrl", r["previewUrl"]), ("appleMusicUrl", r["trackViewUrl"]),
                         ("extendedPreviewUrl", extended_preview(r["trackViewUrl"]))):
        if value and t.get(field) != value:
            changes.append(f"  UPDATED {t['title']}: {field}")
            t[field] = value
    with tempfile.TemporaryDirectory() as tmp:
        fresh = os.path.join(tmp, "cover.jpg")
        fetch_cover(r, fresh)
        if not same_image(fresh, ROOT + t["thumbnail"]):
            changes.append(f"  UPDATED {t['title']}: cover")
            if not dry:
                os.replace(fresh, ROOT + t["thumbnail"])


def confirm(question):
    try:
        return input(f"{question} [y/N] ").strip().lower() == "y"
    except EOFError:
        return False


def remove_covers(gone, kept):
    used = {t.get("thumbnail") for t in kept}
    for t in gone:
        path = t.get("thumbnail") and ROOT + t["thumbnail"]
        if path and t["thumbnail"] not in used and os.path.exists(path):
            os.remove(path)


def main():
    args = sys.argv[1:]
    dry, full = "--dry-run" in args, "--refresh" in args
    args = [a for a in args if a not in ("--dry-run", "--refresh")]
    tracks = yaml.safe_load(open(YML)) or []
    changes, problems, matched, new = [], [], set(), []
    for line, title, artist in read_note(args[0] if args else NOTE):
        i = next((i for i, t in enumerate(tracks)
                  if similar(title, t["title"]) and artist_matches(artist, t["artist"])), None)
        if i is None:
            new.append((line, title, artist))
        elif i not in matched:
            matched.add(i)
            if full:
                refresh(tracks[i], line, title, artist, dry, changes, problems)

    for line, title, artist in new:
        r = find_on_apple(title, artist)
        if not r:
            problems.append(f"  NOT FOUND on Apple: {line}")
            continue
        name = clean_title(r["trackName"])
        genre, why = guess_genre(artist, r["primaryGenreName"], tracks)
        ep = extended_preview(r["trackViewUrl"])
        slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
        flag = "" if genre else "   <-- no genre, set it by hand or it won't show"
        changes.append(f"  NEW {line}\n    => {name} | {r['artistName']} | genre: {genre or '?'} ({why})"
                       f" | {'90 s' if ep else '30 s only'} preview{flag}")
        if not dry:
            fetch_cover(r, os.path.join(COVERS, f"{slug}.jpg"))
        tracks.append({"title": name, "artist": r["artistName"], "genre": genre or "CHOOSE",
                       "thumbnail": f"/assets/images/music/{slug}.jpg", "previewUrl": r["previewUrl"],
                       "extendedPreviewUrl": ep, "appleMusicUrl": r["trackViewUrl"]})
        matched.add(len(tracks) - 1)

    gone = [t for i, t in enumerate(tracks) if i not in matched]
    if gone and not full:
        problems += [f"  ON THE PAGE BUT NOT IN THE NOTE (left as is; --refresh removes it): "
                     f"{t['title']} - {t['artist']}" for t in gone]
    if gone and full:
        print("Not in the note any more, so these would be removed:")
        print("\n".join(f"  {t['title']} - {t['artist']}" for t in gone))
        if dry or confirm(f"Remove these {len(gone)} song(s) and their covers?"):
            changes += [f"  REMOVED {t['title']} - {t['artist']}" for t in gone]
            tracks = [t for t in tracks if t not in gone]
            if not dry:
                remove_covers(gone, tracks)
        else:
            problems.append("  Kept the songs above; nothing removed.")

    print("\n".join(changes) if changes else "No changes: the page already matches the note.")
    if changes and not dry:
        open(YML, "w").write(dump(tracks))
        print(f"Updated _data/music.yml ({len(changes)} change(s)). Sections: {', '.join(GENRES)}.")
    for p in problems:
        print(p)
    if dry and changes:
        cmd = " ".join(["bin/add-songs"] + (["--refresh"] if full else []) + [shlex.quote(a) for a in args])
        print(f"\nDry run only, nothing was written. To make these changes on the website, run:\n  {cmd}")


if __name__ == "__main__":
    main()
