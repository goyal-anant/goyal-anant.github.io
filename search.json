---
layout: null
permalink: /search.json
---
[
{% assign first = true %}
{% for post in site.posts %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {% capture hi_body %}{% if post.hindi %}{% include hindi.html doc=post %}{% else %}{{ post.content }}{% endif %}{% endcapture %}
  {"title": {{ post.title | jsonify }}, "title_hi": {{ post.title_hi | default: post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "section": "Blog", "section_hi": "ब्लॉग", "body": {{ post.subtitle | append: ' ' | append: post.content | strip_html | normalize_whitespace | jsonify }}, "body_hi": {{ post.subtitle_hi | default: post.subtitle | append: ' ' | append: hi_body | strip_html | normalize_whitespace | jsonify }}}
{% endfor %}
{% comment %} Rants hidden for now.
{% for rant in site.rants %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {"title": {{ rant.title | jsonify }}, "url": {{ rant.url | relative_url | jsonify }}, "section": "Rant", "body": {{ rant.content | strip_html | normalize_whitespace | jsonify }}}
{% endfor %}
{% endcomment %}
{% for item in site.research %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {% capture hi_body %}{% if item.hindi %}{% include hindi.html doc=item %}{% else %}{{ item.content }}{% endif %}{% endcapture %}
  {"title": {{ item.title | jsonify }}, "title_hi": {{ item.title_hi | default: item.title | jsonify }}, "url": {{ item.url | relative_url | jsonify }}, "section": "Research", "section_hi": "रिसर्च", "body": {{ item.summary | append: ' ' | append: item.content | strip_html | normalize_whitespace | jsonify }}, "body_hi": {{ item.summary_hi | default: item.summary | append: ' ' | append: hi_body | strip_html | normalize_whitespace | jsonify }}}
{% endfor %}
{% for book in site.data.books %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {"title": {{ book.title | jsonify }}, "url": {{ '/bookshelf/' | relative_url | jsonify }}, "section": "Bookshelf", "body": {{ book.author | append: ' ' | append: book.genre | append: ' ' | append: book.status | append: ' ' | append: book.summary | jsonify }}}
{% endfor %}
{% for track in site.data.music %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {"title": {{ track.title | jsonify }}, "url": {{ '/music/' | relative_url | jsonify }}, "section": "Music", "body": {{ track.artist | append: ' ' | append: track.note | jsonify }}}
{% endfor %}
{% for pick in site.data.picks %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {"title": {{ pick.title | jsonify }}, "url": {{ '/picks/' | relative_url | jsonify }}, "section": "Picks", "body": {{ pick.section | append: ' ' | append: pick.note | jsonify }}}
{% endfor %}
{% comment %} Section pages only list items already indexed above, so index just their title. {% endcomment %}
{% assign listing_pages = "/blog/,/bookshelf/,/music/,/picks/,/rant/,/research/" | split: "," %}
{% for p in site.html_pages %}
  {% if p.title %}
    {% unless first %},{% endunless %}{% assign first = false %}
    {% if listing_pages contains p.url %}{% assign body = "" %}{% else %}{% assign body = p.content | strip_html | normalize_whitespace %}{% endif %}
    {"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "section": "Page", "body": {{ body | jsonify }}}
  {% endif %}
{% endfor %}
]
